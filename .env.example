# ============================================================================
# BRUUX — Template de variables d'environnement
# Copier en .env.local et remplir. NE JAMAIS committer .env.local.
# En production : reporter ces variables dans Vercel → Settings → Env Variables.
# ============================================================================

# === SUPABASE ===
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon...
# Clé service_role — SERVEUR UNIQUEMENT (jamais de préfixe NEXT_PUBLIC).
SUPABASE_SERVICE_ROLE_KEY=eyJ...service_role...

# === CLOUDINARY (images du site principal) ===
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=ton-cloud-name
CLOUDINARY_CLOUD_NAME=ton-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# === GOOGLE AI (optionnel) ===
GEMINI_API_KEY=

# ============================================================================
# BILLETTERIE DÉFILÉ 4 JUILLET — /defile
# ============================================================================

# Mot de passe de l'interface de scan (/defile/admin). À CHANGER pour une
# valeur forte avant l'événement.
DEFILE_ADMIN_PASSWORD=change-moi

# Numéros Mobile Money de l'organisateur (affichés dans les instructions de paiement).
DEFILE_AIRTEL_NUMBER=+241 XX XX XX XX
DEFILE_MOOV_NUMBER=+241 XX XX XX XX

# WaSender (envoi WhatsApp du QR après validation admin)
WASENDER_API_KEY=
# Optionnel : surcharger le host de l'API si différent du défaut wasenderapi.com
# WASENDER_API_URL=https://wasenderapi.com

# Optionnel : URL de base absolue (sinon dérivée de la requête).
# Utile en local pour que FedaPay/WaSender pointent vers la bonne origine.
# DEFILE_BASE_URL=https://www.bruuux.com
